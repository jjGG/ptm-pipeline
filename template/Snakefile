            bash {input.wrapper:q} render \
                --report Analysis_seqlogo.Rmd \
                --output_file Analysis_seqlogo.html \
                --output_dir {params.output_dir:q} \
                --intermediates_dir {params.render_dir:q} \
                xlsx_file={input.xlsx:q} \
                sheet={params.sheet:q} \
                fdr={params.fdr} \
                fc={params.fc} 2>&1 | tee {log:q}
            rm -rf {params.render_dir:q}
            """

# ============================================================
# PTMsigDB Preprocessing
# Downloads human+mouse PTMsigDB, filters by sub-source, trims sequences
# ============================================================
rule prep_ptmsigdb:
    input:
        wrapper = PTM,
        script = CMD["prep_ptmsigdb"],
        prophosqua = PKG
    output:
        rds = PTMSIGDB_FILE,
        gmt = PTMSIGDB_FILE.replace(".rds", ".gmt")
    log:
        f"{PTMSIGDB_DIR}/logs/prep_ptmsigdb.log"
    params:
        output_dir = PTMSIGDB_DIR,
        keep_sources = PTMSIGDB_SOURCES,
        trim_to = PTMSIGDB_TRIM
    shell:
        """
        mkdir -p {params.output_dir:q}/logs
        bash {input.wrapper:q} prep_ptmsigdb \
            --output_dir {params.output_dir:q} \
            --keep_sources {params.keep_sources} \
            --trim_to {params.trim_to} 2>&1 | tee {log:q}
        """

# ============================================================
# PTM-SEA: compute, then report (one pair per analysis type)
# ============================================================
for _analysis in ANALYSIS_TYPES:
    rule:
        name: f"compute_ptmsea_{_analysis}"
        input:
            wrapper = PTM,
            script = CMD["ptmsea"],
            prophosqua = PKG,
            xlsx = f"{DIR_OUT}/PTM_results.xlsx",
            ptmsigdb = PTMSIGDB_FILE
        output:
            xlsx = f"{adir(_analysis)}/PTMSEA/PTMSEA_{aupper(_analysis)}_results.xlsx",
            rds = f"{adir(_analysis)}/PTMSEA/PTMSEA_{aupper(_analysis)}_results.rds"
        log:
            f"{adir(_analysis)}/logs/compute_ptmsea.log"
        params:
            sheet = ANALYSIS_SHEETS[_analysis],
            stat_column = ANALYSIS_STAT_COLS[_analysis],
            analysis_type = aupper(_analysis),
            output_dir = f"{adir(_analysis)}/PTMSEA",
            log_dir = adir(_analysis),
            trim_to = PTMSIGDB_TRIM,
            min_size = GSEA_MIN_SIZE,
            max_size = GSEA_MAX_SIZE,
            n_perm = GSEA_N_PERM
        shell:
            """
            mkdir -p {params.log_dir:q}/logs {params.output_dir:q}
            bash {input.wrapper:q} ptmsea \
                --xlsx_file {input.xlsx:q} \
                --sheet {params.sheet:q} \
                --stat_column {params.stat_column:q} \
                --ptmsigdb_file {input.ptmsigdb:q} \
                --analysis_type {params.analysis_type:q} \
                --output_dir {params.output_dir:q} \
                --trim_to {params.trim_to} \
                --min_size {params.min_size} \
                --max_size {params.max_size} \
                --n_perm {params.n_perm} 2>&1 | tee {log:q}
            """

for _analysis in ANALYSIS_TYPES:
    rule:
        name: f"ptmsea_{_analysis}"
        input:
            wrapper = PTM,
            script = CMD["render"],
            prophosqua = PKG,
            template = report_template("Analysis_PTMSEA.Rmd"),
            objects = f"{adir(_analysis)}/PTMSEA/PTMSEA_{aupper(_analysis)}_results.rds"
        output:
            html = f"{adir(_analysis)}/PTMSEA/PTMSEA_{aupper(_analysis)}.html"
        log:
            f"{adir(_analysis)}/logs/ptmsea.log"
        params:
            analysis_type = aupper(_analysis),
            output_dir = f"{adir(_analysis)}/PTMSEA",
            log_dir = adir(_analysis),
            final_html = f"PTMSEA_{aupper(_analysis)}.html",
            render_dir = render_tmp_dir(_analysis, "ptmsea")
        shell:
            """
            mkdir -p {params.log_dir:q}/logs {params.render_dir:q}
            bash {input.wrapper:q} render \
                --report Analysis_PTMSEA.Rmd \
                --output_file {params.final_html:q} \
                --output_dir {params.output_dir:q} \
                --intermediates_dir {params.render_dir:q} \
                objects_rds={input.objects:q} \
                analysis_type={params.analysis_type:q} \
                output_dir={params.output_dir:q} 2>&1 | tee {log:q}
            rm -rf {params.render_dir:q}
            """

# ============================================================
# KinaseLib Prep (one rule per analysis type)
# Generates seqwindows.tsv and MEA .rnk files for each contrast
# ============================================================
for _analysis in ANALYSIS_TYPES:
    _rnk_files = [f"{adir(_analysis)}/KinaseLib/{aupper(_analysis)}_MEA_{c}.rnk" for c in CONTRASTS]
    rule:
        name: f"prep_kinaselib_{_analysis}"
        input:
            wrapper = PTM,
            script = CMD["prep_kinaselib"],
            prophosqua = PKG,
            xlsx = f"{DIR_OUT}/PTM_results.xlsx"
        output:
            seqwindows = f"{adir(_analysis)}/KinaseLib/{aupper(_analysis)}_seqwindows.tsv",
            rnk_files = _rnk_files
        log:
            f"{adir(_analysis)}/logs/prep_kinaselib.log"
        params:
            output_dir = f"{adir(_analysis)}/KinaseLib",
            log_dir = adir(_analysis),
            analysis_type = aupper(_analysis),
            sheet = ANALYSIS_SHEETS[_analysis],
            stat_column = ANALYSIS_STAT_COLS[_analysis]
        shell:
            """
            mkdir -p {params.log_dir:q}/logs {params.output_dir:q}
            bash {input.wrapper:q} prep_kinaselib \
                --xlsx_file {input.xlsx:q} \
                --output_dir {params.output_dir:q} \
                --analysis_type {params.analysis_type:q} \
                --sheet {params.sheet:q} \
                --stat_column {params.stat_column:q} 2>&1 | tee {log:q}
            """

# ============================================================
# KinaseLib scan-motifs (one rule per analysis type)
# ============================================================
for _analysis in ANALYSIS_TYPES:
    rule:
        name: f"scan_motifs_{_analysis}"
        input:
            f"{adir(_analysis)}/KinaseLib/{aupper(_analysis)}_seqwindows.tsv"
        output:
            f"{adir(_analysis)}/KinaseLib/term2gene.csv"
        log:
            f"{adir(_analysis)}/logs/scan_motifs.log"
        params:
            repo = KL_REPO,
            kin_type = KL_KIN_TYPE,
            threshold = KL_THRESHOLD,
            log_dir = adir(_analysis)
        shell:
            """
            mkdir -p {params.log_dir:q}/logs
            uv tool run --from {params.repo} scan-motifs {input:q} \
                --seq-col SequenceWindow \
                --output {output:q} \
                --kin-type {params.kin_type} \
                --threshold {params.threshold} \
                --term2gene 2>&1 | tee {log:q}
            """

# ============================================================
# KinaseLib run-mea (wildcard for contrast)
# ============================================================
for _analysis in ANALYSIS_TYPES:
    rule:
        name: f"run_mea_{_analysis}"
        input:
            seqwindows = f"{adir(_analysis)}/KinaseLib/{aupper(_analysis)}_seqwindows.tsv",
            rnk = f"{adir(_analysis)}/KinaseLib/{aupper(_analysis)}_MEA_{{contrast}}.rnk"
        output:
            f"{adir(_analysis)}/KinaseLib/mea_{{contrast}}.csv"
        log:
            f"{adir(_analysis)}/logs/mea_{{contrast}}.log"
        threads: MEA_THREADS
        params:
            repo = KL_REPO,
            kin_type = KL_KIN_TYPE,
            threshold = KL_THRESHOLD,
            permutations = KL_PERMUTATIONS,
            log_dir = adir(_analysis)
        shell:
            """
            mkdir -p {params.log_dir:q}/logs
            uv tool run --from {params.repo} run-mea {input.rnk:q} \
                --seq-col SequenceWindow \
                --rank-col statistic.site \
                --output {output:q} \
                --kin-type {params.kin_type} \
                --threshold {params.threshold} \
                --permutations {params.permutations} \
                --threads {threads} 2>&1 | tee {log:q}
            """

# ============================================================
# KinaseLib MEA: collect, then report (one pair per analysis type)
# ============================================================
for _analysis in ANALYSIS_TYPES:
    rule:
        name: f"compute_mea_{_analysis}"
        input:
            wrapper = PTM,
            script = CMD["mea"],
            prophosqua = PKG,
            mea_files = expand(f"{adir(_analysis)}/KinaseLib/mea_{{c}}.csv", c=CONTRASTS)
        output:
            xlsx = f"{adir(_analysis)}/KinaseLib/MEA_{aupper(_analysis)}_results.xlsx",
            rds = f"{adir(_analysis)}/KinaseLib/MEA_{aupper(_analysis)}_results.rds"
        log:
            f"{adir(_analysis)}/logs/compute_mea.log"
        params:
            kinaselib_dir = f"{adir(_analysis)}/KinaseLib",
            log_dir = adir(_analysis),
            analysis_type = aupper(_analysis)
        shell:
            """
            mkdir -p {params.log_dir:q}/logs
            bash {input.wrapper:q} mea \
                --kinaselib_dir {params.kinaselib_dir:q} \
                --analysis_type {params.analysis_type:q} 2>&1 | tee {log:q}
            """

for _analysis in ANALYSIS_TYPES:
    rule:
        name: f"vis_mea_{_analysis}"
        input:
            wrapper = PTM,
            script = CMD["render"],
            prophosqua = PKG,
            template = report_template("Analysis_MEA.Rmd"),
            objects = f"{adir(_analysis)}/KinaseLib/MEA_{aupper(_analysis)}_results.rds"
        output:
            html = f"{adir(_analysis)}/KinaseLib/Analysis_MEA.html"
        log:
            f"{adir(_analysis)}/logs/vis_mea.log"
        params:
            kinaselib_dir = f"{adir(_analysis)}/KinaseLib",
            log_dir = adir(_analysis),
            analysis_type = aupper(_analysis),
            render_dir = render_tmp_dir(_analysis, "vis_mea")
        shell:
            """
            mkdir -p {params.log_dir:q}/logs {params.render_dir:q}
            bash {input.wrapper:q} render \
                --report Analysis_MEA.Rmd \
                --output_file Analysis_MEA.html \
                --output_dir {params.kinaselib_dir:q} \
                --intermediates_dir {params.render_dir:q} \
                objects_rds={input.objects:q} \
                analysis_type={params.analysis_type:q} 2>&1 | tee {log:q}
            rm -rf {params.render_dir:q}
            """

# ============================================================
# KinaseLib GSEA: compute, then report (one pair per analysis type)
# ============================================================
for _analysis in ANALYSIS_TYPES:
    rule:
        name: f"compute_kinaselib_gsea_{_analysis}"
        input:
            wrapper = PTM,
            script = CMD["kinaselib_gsea"],
            prophosqua = PKG,
            xlsx = f"{DIR_OUT}/PTM_results.xlsx",
            term2gene = f"{adir(_analysis)}/KinaseLib/term2gene.csv"
        output:
            xlsx = f"{adir(_analysis)}/KinaseLib/KinaseLib_GSEA_{aupper(_analysis)}.xlsx",
            rds = f"{adir(_analysis)}/KinaseLib/KinaseLib_GSEA_{aupper(_analysis)}.rds"
        log:
            f"{adir(_analysis)}/logs/compute_kinaselib_gsea.log"
        params:
            sheet = ANALYSIS_SHEETS[_analysis],
            analysis_type = aupper(_analysis),
            output_dir = f"{adir(_analysis)}/KinaseLib",
            log_dir = adir(_analysis),
            min_size = GSEA_MIN_SIZE,
            max_size = GSEA_MAX_SIZE,
            n_perm = GSEA_N_PERM
        shell:
            """
            mkdir -p {params.log_dir:q}/logs {params.output_dir:q}
            bash {input.wrapper:q} kinaselib_gsea \
                --xlsx_file {input.xlsx:q} \
                --sheet {params.sheet:q} \
                --term2gene_file {input.term2gene:q} \
                --analysis_type {params.analysis_type:q} \
                --output_dir {params.output_dir:q} \
                --min_size {params.min_size} \
                --max_size {params.max_size} \
                --n_perm {params.n_perm} 2>&1 | tee {log:q}
            """

for _analysis in ANALYSIS_TYPES:
    rule:
        name: f"analysis_kinaselib_{_analysis}"
        input:
            wrapper = PTM,
            script = CMD["render"],
            prophosqua = PKG,
            template = report_template("Analysis_KinaseLibrary.Rmd"),
