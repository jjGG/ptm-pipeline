# Snakefile - Unified PTM Analysis Pipeline
# Uses standardized output format with combined PTM_results.xlsx
#
# Every rule that runs R does so through ptm.sh, the wrapper shipped with
# prophosqua, which resolves the named command's R script from the installed
# package. The project therefore holds no R code, and no rule embeds any: one
# entry point, one place where the analysis lives. `./ptm.sh help` lists the
# commands; running one by hand runs exactly what the rule runs.
#
# Rules come in two tiers. `data` computes and writes data products; `reports`
# renders HTML from what those wrote and can be re-run on its own.
#
# Usage:
#   snakemake -j1 all                              # uses default ptm_config.yaml
#   snakemake -j1 data                             # data products only
#   snakemake -j1 reports                          # reports only
#   snakemake --configfile custom.yaml -j1 all

from helpers import (
    build_analysis_lookups,
    get_dea_xlsx_path,
    get_dea_yaml_path,
    get_parquet_path,
    get_prophosqua_file,
    get_prophosqua_install_stamp,
    render_tmp_dir,
)

# Default config file (can be overridden with --configfile)
configfile: "ptm_config.yaml"

# Convenience aliases from config
DIR_OUT = config["dir_out"]
PHOSPHO_DEA_DIR = config["phospho_dea_dir"]
PROTEIN_DEA_DIR = config["protein_dea_dir"]
ANNOT_FILE = config["annot_file"]
MAX_FIG = config["max_fig"]
CONTRASTS = config["contrasts"]
FDR_THRESHOLD = config.get("fdr", 0.05)
LOG2FC_THRESHOLD = config.get("log2fc", 0.5)
KL_REPO = config["kinaselib"]["repo"]
KL_KIN_TYPE = config["kinaselib"]["kin_type"]
KL_THRESHOLD = config["kinaselib"]["threshold"]
KL_PERMUTATIONS = config["kinaselib"]["permutations"]
MEA_THREADS = config["threads"]["mea"]
RUN_KINASE = config.get("run_kinase", True)

# GSEA parameters (shared by PTM-SEA and KinaseLib GSEA)
_gsea_cfg = config.get("gsea", {})
GSEA_MIN_SIZE = _gsea_cfg.get("min_size", 10)
GSEA_MAX_SIZE = _gsea_cfg.get("max_size", 500)
GSEA_N_PERM = _gsea_cfg.get("n_perm", 1000)

# PTMsigDB preprocessing config
_ptmsigdb = config.get("ptmsigdb", {})
PTMSIGDB_SOURCES = ",".join(_ptmsigdb.get("keep_sources", ["KINASE-PSP"]))
PTMSIGDB_TRIM = _ptmsigdb.get("trim_to", 15)
PTMSIGDB_DIR = _ptmsigdb.get("output_dir", "data/ptmsigdb")
PTMSIGDB_FILE = f"{PTMSIGDB_DIR}/ptmsigdb_filtered_{PTMSIGDB_SOURCES.replace(',', '_')}_{PTMSIGDB_TRIM}mer.rds"

# ============================================================
# The installed prophosqua: wrappers, command scripts, reports
#
# Each rule declares the wrapper it calls and the script or template that
# wrapper reaches, so that reinstalling prophosqua invalidates exactly the rules
# whose code changed. Resolving them here also fails the parse, rather than a
# rule halfway through a run, when the package is missing or too old.
# ============================================================
# One wrapper for every step: `ptm.sh <command> [options]`. It resolves the
# command's script from the installation, so a work directory holds a single
# file, and `ptm.sh help` lists the steps as the installed package has them.
PTM = get_prophosqua_file("bin/ptm.sh")
CMD = {
    name: get_prophosqua_file(f"CMD_{name.upper()}.R")
    for name in (
        "dpa_dpu", "cf_dea", "combine_results", "prep_ptmsigdb",
        "prep_kinaselib", "dpu_overview", "ptmsea", "kinaselib_gsea", "mea",
        "render",
    )
}

# A rule's real dependency is the whole installed package, not only the script it
# names: the script's work happens in prophosqua's R code. Declaring this makes a
# reinstall invalidate every rule that runs R.
PKG = get_prophosqua_install_stamp()

def report_template(name):
    """Resolve one of the report templates prophosqua ships."""
    return get_prophosqua_file(name)

# Build lookup dictionaries from config
LOOKUPS = build_analysis_lookups(DIR_OUT, config["analyses"])
ANALYSIS_TYPES = LOOKUPS["types"]  # ["dpa", "dpu", "cf"]
ANALYSIS_DIRS = LOOKUPS["dirs"]     # {"dpa": "PTM_V2_Testing/PTM_DPA", ...}
ANALYSIS_SHEETS = LOOKUPS["sheets"] # {"dpa": "DPA", ...}
ANALYSIS_STAT_COLS = LOOKUPS["stat_columns"]

# Global wildcard constraints
wildcard_constraints:
    analysis = "dpa|dpu|cf"

# Helper to get directory from analysis type
def adir(analysis):
    """Get output directory for analysis type."""
    return ANALYSIS_DIRS[analysis]

def aupper(analysis):
    """Get uppercase name for analysis type."""
    return ANALYSIS_SHEETS[analysis]

# ============================================================
# Tier targets and default target
# ============================================================
DATA_TARGETS = [
    f"{ANALYSIS_DIRS['dpa']}/Result_DPA.xlsx",
    f"{ANALYSIS_DIRS['dpu']}/Result_DPU.xlsx",
    f"{ANALYSIS_DIRS['cf']}/CorrectFirst_PTM_usage_results.xlsx",
    f"{DIR_OUT}/PTM_results.xlsx",
    f"{DIR_OUT}/PTM_results.rds",
]
if RUN_KINASE:
    DATA_TARGETS += (
        [f"{adir(a)}/KinaseLib/term2gene.csv" for a in ANALYSIS_TYPES]
        + [
            f"{adir(a)}/KinaseLib/mea_{c}.csv"
            for a in ANALYSIS_TYPES for c in CONTRASTS
        ]
        # The three enrichment analyses write their results whether or not
        # anything was enriched, which is what lets them be declared here.
        + [
            f"{adir(a)}/PTMSEA/PTMSEA_{aupper(a)}_results.{ext}"
            for a in ANALYSIS_TYPES for ext in ("xlsx", "rds")
        ]
        + [
            f"{adir(a)}/KinaseLib/KinaseLib_GSEA_{aupper(a)}.{ext}"
            for a in ANALYSIS_TYPES for ext in ("xlsx", "rds")
        ]
        + [
            f"{adir(a)}/KinaseLib/MEA_{aupper(a)}_results.{ext}"
            for a in ANALYSIS_TYPES for ext in ("xlsx", "rds")
        ]
    )

REPORT_TARGETS = (
    [
        f"{ANALYSIS_DIRS['dpa']}/Analysis_DPA_DPU.html",
        f"{ANALYSIS_DIRS['cf']}/Analysis_CorrectFirst_DEA.html",
        f"{ANALYSIS_DIRS['dpu']}/Result_DPU.html",
    ]
    + expand("{d}/Analysis_n_to_c.html", d=ANALYSIS_DIRS.values())
    + expand("{d}/Analysis_seqlogo.html", d=ANALYSIS_DIRS.values())
    + ([f"{adir(a)}/PTMSEA/PTMSEA_{aupper(a)}.html" for a in ANALYSIS_TYPES] if RUN_KINASE else [])
    + ([f"{adir(a)}/KinaseLib/Analysis_KinaseLib_{aupper(a)}.html" for a in ANALYSIS_TYPES] if RUN_KINASE else [])
    + (expand("{d}/KinaseLib/Analysis_MEA.html", d=ANALYSIS_DIRS.values()) if RUN_KINASE else [])
    + [f"{DIR_OUT}/index.html"]
)

rule all:
    input:
        DATA_TARGETS,
        REPORT_TARGETS,
        # Zip archives (results + DEA inputs)
        f"{DIR_OUT}.zip",
        f"{PHOSPHO_DEA_DIR}.zip",
        f"{PROTEIN_DEA_DIR}.zip"

rule data:
    input:
        DATA_TARGETS

rule reports:
    input:
        REPORT_TARGETS

# ============================================================
# DPA and DPU: compute, then report
# ============================================================
rule compute_dpa_dpu:
    input:
        wrapper = PTM,
        script = CMD["dpa_dpu"],
        prophosqua = PKG,
        # The computation resolves these from the DEA directories itself.
        # Declared so that rerunning a DEA rebuilds what this pipeline derives.
        protein_xlsx = get_dea_xlsx_path(PROTEIN_DEA_DIR),
        phospho_xlsx = get_dea_xlsx_path(PHOSPHO_DEA_DIR)
    output:
        dpa_xlsx = f"{ANALYSIS_DIRS['dpa']}/Result_DPA.xlsx",
        dpu_xlsx = f"{ANALYSIS_DIRS['dpu']}/Result_DPU.xlsx",
        dpu_rds = f"{ANALYSIS_DIRS['dpu']}/combined_test_diff.rds",
        objects = f"{ANALYSIS_DIRS['dpa']}/dpa_dpu_objects.rds"
    log:
        f"{DIR_OUT}/logs/compute_dpa_dpu.log"
    params:
        dpa_dir = ANALYSIS_DIRS['dpa'],
        dpu_dir = ANALYSIS_DIRS['dpu'],
        phospho_dea_dir = PHOSPHO_DEA_DIR,
        protein_dea_dir = PROTEIN_DEA_DIR
    shell:
        """
        mkdir -p {DIR_OUT}/logs
        bash {input.wrapper:q} dpa_dpu \
            --phospho_dea_dir {params.phospho_dea_dir:q} \
            --protein_dea_dir {params.protein_dea_dir:q} \
            --dpa_dir {params.dpa_dir:q} \
            --dpu_dir {params.dpu_dir:q} 2>&1 | tee {log:q}
        """

rule report_dpa_dpu:
    input:
        wrapper = PTM,
        script = CMD["render"],
        prophosqua = PKG,
        template = report_template("Analysis_DPA_DPU.Rmd"),
        objects = f"{ANALYSIS_DIRS['dpa']}/dpa_dpu_objects.rds"
    output:
        html = f"{ANALYSIS_DIRS['dpa']}/Analysis_DPA_DPU.html"
    log:
        f"{ANALYSIS_DIRS['dpa']}/logs/report_dpa_dpu.log"
    params:
        output_dir = ANALYSIS_DIRS['dpa'],
        render_dir = render_tmp_dir("dpa", "report_dpa_dpu")
    shell:
        """
        mkdir -p {params.output_dir:q}/logs {params.render_dir:q}
        bash {input.wrapper:q} render \
            --report Analysis_DPA_DPU.Rmd \
            --output_file Analysis_DPA_DPU.html \
            --output_dir {params.output_dir:q} \
            --intermediates_dir {params.render_dir:q} \
            objects_rds={input.objects:q} 2>&1 | tee {log:q}
        rm -rf {params.render_dir:q}
        """

rule render_dpu_overview:
    input:
        wrapper = PTM,
        script = CMD["dpu_overview"],
        prophosqua = PKG,
        template = report_template("_Overview_PhosphoAndIntegration_site.Rmd"),
        rds = f"{ANALYSIS_DIRS['dpu']}/combined_test_diff.rds"
    output:
        html = f"{ANALYSIS_DIRS['dpu']}/Result_DPU.html"
    log:
        f"{ANALYSIS_DIRS['dpu']}/logs/render_dpu_overview.log"
    params:
        output_dir = ANALYSIS_DIRS['dpu']
    shell:
        """
        mkdir -p {params.output_dir:q}/logs
        bash {input.wrapper:q} dpu_overview \
            --input_rds {input.rds:q} \
            --output_dir {params.output_dir:q} 2>&1 | tee {log:q}
        """

# ============================================================
# CorrectFirst: compute, then report
# ============================================================
rule compute_cf_dea:
    input:
        wrapper = PTM,
        script = CMD["cf_dea"],
        prophosqua = PKG,
        # The computation resolves these itself. Declared so that rerunning a
        # DEA, or editing the annotation that defines the model and its
        # contrasts, rebuilds the CorrectFirst results.
        annot = ANNOT_FILE,
        protein_parquet = get_parquet_path(PROTEIN_DEA_DIR),
        protein_yaml = get_dea_yaml_path(PROTEIN_DEA_DIR),
        phospho_parquet = get_parquet_path(PHOSPHO_DEA_DIR),
        phospho_yaml = get_dea_yaml_path(PHOSPHO_DEA_DIR),
        phospho_xlsx = get_dea_xlsx_path(PHOSPHO_DEA_DIR)
    output:
        xlsx = f"{ANALYSIS_DIRS['cf']}/CorrectFirst_PTM_usage_results.xlsx",
        wide = f"{ANALYSIS_DIRS['cf']}/CorrectFirst_intensities_wide.xlsx",
        annotation = f"{ANALYSIS_DIRS['cf']}/CorrectFirst_intensities_file_annotation.xlsx",
        objects = f"{ANALYSIS_DIRS['cf']}/cf_objects.rds"
    log:
        f"{DIR_OUT}/logs/compute_cf_dea.log"
    params:
        output_dir = ANALYSIS_DIRS['cf'],
        phospho_dea_dir = PHOSPHO_DEA_DIR,
        protein_dea_dir = PROTEIN_DEA_DIR,
        annot_file = ANNOT_FILE
    shell:
        """
        mkdir -p {DIR_OUT}/logs
        bash {input.wrapper:q} cf_dea \
            --phospho_dea_dir {params.phospho_dea_dir:q} \
            --protein_dea_dir {params.protein_dea_dir:q} \
            --annot_file {params.annot_file:q} \
            --output_dir {params.output_dir:q} 2>&1 | tee {log:q}
        """

rule report_cf_dea:
    input:
        wrapper = PTM,
        script = CMD["render"],
        prophosqua = PKG,
        template = report_template("Analysis_CorrectFirst_DEA.Rmd"),
        objects = f"{ANALYSIS_DIRS['cf']}/cf_objects.rds"
    output:
        html = f"{ANALYSIS_DIRS['cf']}/Analysis_CorrectFirst_DEA.html"
    log:
        f"{ANALYSIS_DIRS['cf']}/logs/report_cf_dea.log"
    params:
        output_dir = ANALYSIS_DIRS['cf'],
        render_dir = render_tmp_dir("cf", "report_cf_dea")
    shell:
        """
        mkdir -p {params.output_dir:q}/logs {params.render_dir:q}
        bash {input.wrapper:q} render \
            --report Analysis_CorrectFirst_DEA.Rmd \
            --output_file Analysis_CorrectFirst_DEA.html \
            --output_dir {params.output_dir:q} \
            --intermediates_dir {params.render_dir:q} \
            objects_rds={input.objects:q} \
            results_xlsx=CorrectFirst_PTM_usage_results.xlsx 2>&1 | tee {log:q}
        rm -rf {params.render_dir:q}
        """

# ============================================================
# Combine Results
# ============================================================
rule combine_results:
    input:
        wrapper = PTM,
        script = CMD["combine_results"],
        prophosqua = PKG,
        dpa = f"{ANALYSIS_DIRS['dpa']}/Result_DPA.xlsx",
        dpu = f"{ANALYSIS_DIRS['dpu']}/Result_DPU.xlsx",
        cf = f"{ANALYSIS_DIRS['cf']}/CorrectFirst_PTM_usage_results.xlsx",
        # The abundance sheets of the combined workbook are read from these.
        protein_pq = get_parquet_path(PROTEIN_DEA_DIR),
        site_pq = get_parquet_path(PHOSPHO_DEA_DIR)
    output:
        xlsx = f"{DIR_OUT}/PTM_results.xlsx",
        rds = f"{DIR_OUT}/PTM_results.rds"
    log:
        f"{DIR_OUT}/logs/combine_results.log"
    shell:
        """
        mkdir -p {DIR_OUT}/logs
        bash {input.wrapper:q} combine_results \
            --dpa_xlsx {input.dpa:q} \
            --dpu_xlsx {input.dpu:q} \
            --cf_xlsx {input.cf:q} \
            --protein_parquet {input.protein_pq:q} \
            --site_parquet {input.site_pq:q} \
            --output_xlsx {output.xlsx:q} \
            --output_rds {output.rds:q} 2>&1 | tee {log:q}
        """

# ============================================================
# N-to-C Analysis (one rule per analysis type)
# ============================================================
for _analysis in ANALYSIS_TYPES:
    rule:
        name: f"n_to_c_{_analysis}"
        input:
            wrapper = PTM,
            script = CMD["render"],
            prophosqua = PKG,
            template = report_template("Analysis_n_to_c.Rmd"),
            xlsx = f"{DIR_OUT}/PTM_results.xlsx"
        output:
            html = f"{adir(_analysis)}/Analysis_n_to_c.html"
        log:
            f"{adir(_analysis)}/logs/n_to_c.log"
        params:
            sheet = ANALYSIS_SHEETS[_analysis],
            analysis_type = _analysis,
            output_dir = adir(_analysis),
            max_fig = MAX_FIG,
            fdr = FDR_THRESHOLD,
            fc = LOG2FC_THRESHOLD,
            render_dir = render_tmp_dir(_analysis, "n_to_c")
        shell:
            """
            mkdir -p {params.output_dir:q}/logs {params.render_dir:q}
            bash {input.wrapper:q} render \
                --report Analysis_n_to_c.Rmd \
                --output_file Analysis_n_to_c.html \
                --output_dir {params.output_dir:q} \
                --intermediates_dir {params.render_dir:q} \
                xlsx_file={input.xlsx:q} \
                sheet={params.sheet:q} \
                analysis_type={params.analysis_type:q} \
                output_dir={params.output_dir:q} \
                max_fig={params.max_fig} \
                fdr={params.fdr} \
                fc={params.fc} 2>&1 | tee {log:q}
            rm -rf {params.render_dir:q}
            """

# ============================================================
